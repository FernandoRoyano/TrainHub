# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Email)
RESEND_API_KEY=your-resend-api-key

# Stripe (Payments)
# NEXT_PUBLIC_ENABLE_PAYMENTS controla la UI de upgrade: "true" muestra los
# botones de pago. Requiere el resto de variables Stripe configuradas.
NEXT_PUBLIC_ENABLE_PAYMENTS=false
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ELITE_MONTHLY=price_...
STRIPE_PRICE_ELITE_YEARLY=price_...
# Config del Billing Portal de TrainHub (bpc_...). Necesaria porque la cuenta
# Stripe se comparte con otros proyectos y la default no es la de TrainHub.
STRIPE_PORTAL_CONFIG_ID=bpc_...
